# Postgres connection (per-app role in the meizuno stack: calories_user).
DATABASE_URL=postgres://calories_user:password@localhost:5432/calories?sslmode=disable

# HTTP port (default).
PORT=8080

# Dev fallback identity when no SSO token is present (local use).
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# meizuno SSO: when set, the auth middleware validates the access_token cookie
# against the auth service and uses the returned user_id. Empty = dev fallback.
AUTH_VALIDATE_URL=

# ── assistant ────────────────────────────────────────────────────────────────
# The in-app chat. Unset means no assistant at all: the endpoint answers 503
# and the client hides the nav item, so leaving this out is a supported state.
#   mock    canned replies, no model called, no key needed - for local UI work
#   openai  a real model (needs ASSISTANT_API_KEY)
ASSISTANT=
ASSISTANT_API_KEY=
# Optional. Defaults to gpt-5.6-luna: the cheapest current model that does both
# vision (meal photos) and tool calling, which is the minimum this needs.
ASSISTANT_MODEL=
# Optional. Sent as reasoning_effort. Must be "none" (the default) whenever the
# model reasons by default, because chat completions refuses function tools and
# reasoning together - and this assistant is a tool loop. Set it EMPTY for a
# model old enough to reject the parameter as unknown.
ASSISTANT_REASONING=none
# Optional. Messages per profile per window - the cost ceiling, keyed by
# account rather than address because the bill follows the account.
ASSISTANT_RATE_LIMIT=30
ASSISTANT_RATE_WINDOW=1h
